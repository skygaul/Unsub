# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon key 또는 publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Claude API (서버에서만 사용, 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것)
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY
# 선택: 문자 파싱에 쓸 모델 (기본값 claude-haiku-5-5, 가장 저렴). 키가 없어도 규칙 기반 파서는 동작함
# ANTHROPIC_MODEL=claude-haiku-5-5

# 선택: 해지 가이드(공개 데이터)를 몇 초 동안 캐시할지 (기본값 300초 = 5분). 0이면 캐시하지 않음.
# 개발 중 DB를 고치고 바로 확인하고 싶을 때 0으로 두면 편함. 운영에서 바꾸면 재배포해야 반영됨.
# SERVICES_REVALIDATE_SECONDS=300
